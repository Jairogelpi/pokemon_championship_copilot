# Optional. The app works without OpenAI and falls back to its local parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Codex is the final strategic selector when configured. It may choose only
# from the deterministic engine's verified legal-action catalog.
OPENAI_BATTLE_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_TIMEOUT_SECONDS=25

# Live verified-sampled search. It defaults on when Codex is configured and
# off in deterministic-only deployments. One-turn coverage remains exhaustive;
# future branches are deterministic samples and are never labelled exhaustive.
MULTITURN_ENABLED=true
MULTITURN_DEPTH=2
MULTITURN_ROOT_ACTIONS=3
MULTITURN_FUTURE_ACTIONS=2
MULTITURN_RESPONSE_SAMPLES=2
MULTITURN_CHANCE_SAMPLES=2
MULTITURN_NODE_BUDGET=900
MULTITURN_TIME_BUDGET_MS=8000
MULTITURN_VERIFIED_FRONTIER=0.90

# Server configuration
COPILOT_HOST=127.0.0.1
COPILOT_PORT=8765

# Optional override. By default the service discovers `node` from PATH.
SHOWDOWN_NODE=
